#include<pic.h>
void delay_ms(unsigned int ms){
unsigned int i,j;
for(i=0;i<ms;i++)
for(j=0;j<1275;j++);
}
void i2c_init(){
TRISC3=1;
TRISC4=1;
SSPCON=0x28;
SSPCON2=0x00;
SSPADD=49;
SSPSTAT=0x00;
}
void i2c_wait(){
while((SSPCON2&0x1F)||(SSPSTAT&0x04));
}
void i2c_start(){
i2c_wait();
SEN=1;
}
void i2c_restart(){
i2c_wait();
RSEN=1;
}
void i2c_stop(){
i2c_wait();
PEN=1;
}
void i2c_write(unsigned char data){
i2c_wait();
SSPBUF=data;
}
unsigned char i2c_read(unsigned char ack){
unsigned char data;
i2c_wait();
RCEN=1;
i2c_wait();
data=SSPBUF;
i2c_wait();
if(ack)
ACKDT=0;
else
ACKDT=1;
ACKEN=1;
return data;
}
void eeprom_write(unsigned char addr,unsigned char data){
i2c_start();
i2c_write(0xA0);
i2c_write(addr);
i2c_write(data);
i2c_stop();
delay_ms(50);
}
unsigned char eeprom_read(unsigned char addr){
unsigned char data;
i2c_start();
i2c_write(0xA0);
i2c_write(addr);
i2c_restart();
i2c_write(0xA1);
data=i2c_read(0);
i2c_stop();
return data;
}
void main(){
unsigned char value;
i2c_init();
eeprom_write(0x10,0x55);
value=eeprom_read(0x10);
while(1);
}
